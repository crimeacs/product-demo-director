def pipeline(project_value: str, *, generate: bool, judge: bool) -> None:
    load_dotenv()
    py = venv_python()
    project = Path(project_value).expanduser()
    if not project.is_absolute():
        project = (ROOT / project).resolve()
    if not (project / "script.json").exists():
        raise SystemExit(f"No script.json found in {project}")

    if generate:
        run([py, str(ROOT / "tools" / "preflight.py"), "--project", str(project),
             "--allow-pending-generated-narration"])
        run([py, str(ROOT / "tools" / "vo.py"), "--project", str(project)])
        with open(project / "script.json") as handle:
            generated_script = json.load(handle)
        production = generated_script.get("production") if isinstance(generated_script.get("production"), dict) else {}
        if production.get("autoPaceNarration"):
            run([py, str(ROOT / "tools" / "pace.py"), "--project", str(project), "--write"])
        run([py, str(ROOT / "tools" / "music.py"), "--project", str(project)])
    run([py, str(ROOT / "tools" / "preflight.py"), "--project", str(project), "--strict"])
    run([py, str(ROOT / "tools" / "build.py"), "--project", str(project),
         "--contracts", "strict"])

    creative = project / "out" / "demo.mp4"
    final = project / "out" / "demo-final.mp4"
    run([py, str(ROOT / "tools" / "finish.py"), "--input", str(creative),
         "--out", str(final), "--require-artifact"])
    run([py, str(ROOT / "tools" / "qa.py"), "--video", str(final),
         "--project", str(project), "--require-artifact", "--strict"])
    if judge:
        run([py, str(ROOT / "tools" / "judge.py"), "--video", str(final),
             "--require-artifact", "--fps", "4"])
    print(f"\nReady: {final}")


def cmd_render(args: argparse.Namespace) -> None:
    pipeline(args.project, generate=False, judge=args.judge)


def cmd_demo(args: argparse.Namespace) -> None:
    pipeline(args.project, generate=True, judge=args.judge)


def parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="pdd", description=__doc__)
    sub = ap.add_subparsers(dest="command", required=True)

    setup = sub.add_parser("setup", help="install Python and Remotion dependencies")
    setup.add_argument("--with-capture", action="store_true", help="also install Playwright Chromium")
    setup.set_defaults(func=cmd_setup)

    doctor = sub.add_parser("doctor", help="check local tools, dependencies, keys, and disk space")
    doctor.set_defaults(func=cmd_doctor)

    test = sub.add_parser("test", help="run Python tests and the TypeScript checker")
    test.set_defaults(func=cmd_test)

    install_skill = sub.add_parser(
        "install-skill",
        help="link this repository as a Codex and/or Claude Code skill",
    )
    install_skill.add_argument(
        "--target",
        choices=("codex", "claude", "both"),
        default="both",
        help="skill host to install for (default: both)",
    )
    install_skill.set_defaults(func=cmd_install_skill)

    new = sub.add_parser("new", help="create a starter project")
    new.add_argument("project", help="new project directory")
    new.add_argument("--name", default="", help="product name shown in the starter script")
    new.set_defaults(func=cmd_new)

    for command, help_text, func in (
        ("render", "render and QA a project whose audio already exists", cmd_render),
        ("demo", "generate audio, render, finish, and QA a project", cmd_demo),
    ):
        item = sub.add_parser(command, help=help_text)
        item.add_argument("project")
        item.add_argument("--judge", action="store_true", help="also run the optional AI taste review")
        item.set_defaults(func=func)
    return ap


def main() -> None:
    args = parser().parse_args()
    try:
        args.func(args)
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode) from exc


if __name__ == "__main__":
    main()
