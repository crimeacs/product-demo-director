import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
ENGINE = ROOT / "engine"
VENV = ROOT / ".venv"
SKILL_INSTALL_PATHS = {
    "codex": Path(".agents") / "skills" / "product-demo-director",
    "claude": Path(".claude") / "skills" / "product-demo-director",
}


def load_dotenv() -> None:
    """Load the repo's simple KEY=value file without overriding the shell."""
    path = ROOT / ".env"
    if not path.exists():
        return
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if value[:1] == value[-1:] and value[:1] in {"'", '"'}:
            value = value[1:-1]
        if key and value:
            os.environ.setdefault(key, value)


def run(command: list[str], *, cwd: Path = ROOT) -> None:
    print("+", " ".join(command), flush=True)
    subprocess.run(command, cwd=cwd, check=True)


def venv_python() -> str:
    candidates = [VENV / "bin" / "python", VENV / "Scripts" / "python.exe"]
    for candidate in candidates:
        if candidate.exists():
            return str(candidate)
    raise SystemExit("Run `./pdd setup` first; .venv is missing.")


def cmd_setup(args: argparse.Namespace) -> None:
    if not VENV.exists():
        run([sys.executable, "-m", "venv", str(VENV)])
    py = venv_python()
    run([py, "-m", "pip", "install", "--upgrade", "pip"])
    run([py, "-m", "pip", "install", "-r", str(ROOT / "tools" / "requirements.txt")])
    if not shutil.which("npm"):
        raise SystemExit("npm was not found. Install Node.js 18 or newer, then rerun setup.")
    run(["npm", "ci"], cwd=ENGINE)
    if args.with_capture:
        run([py, "-m", "playwright", "install", "chromium"])
    print("\nSetup complete. Run `./pdd doctor` to verify the workstation.")


def cmd_doctor(_: argparse.Namespace) -> None:
    run([sys.executable, str(ROOT / "tools" / "doctor.py")])


def cmd_test(_: argparse.Namespace) -> None:
    py = venv_python()
    run([py, "-m", "unittest", "discover", "-s", "tests", "-v"])
    run(["npm", "run", "type-check"], cwd=ENGINE)


def _path_exists(path: Path) -> bool:
    """Return True for regular paths and broken symlinks."""
    return os.path.lexists(os.fspath(path))


def _link_points_to(path: Path, source: Path) -> bool:
    if not path.is_symlink():
        return False
    try:
        return path.resolve(strict=False) == source.resolve(strict=True)
    except (OSError, RuntimeError):
        return False


def _assert_parent_can_hold(destination: Path) -> None:
    """Reject an existing non-directory anywhere in the missing parent chain."""
    candidate = destination.parent
    while not _path_exists(candidate):
        candidate = candidate.parent
    if not candidate.is_dir():
        raise SystemExit(
            f"Refusing to install skill: parent path is not a directory: {candidate}"
        )


def _validate_skill_destination(destination: Path, source: Path) -> str:
    _assert_parent_can_hold(destination)
    if not _path_exists(destination):
        return "create"
    if _link_points_to(destination, source):
        return "current"
    kind = "symlink" if destination.is_symlink() else "path"
    raise SystemExit(
        f"Refusing to overwrite unrelated existing {kind}: {destination}"
    )


def cmd_install_skill(args: argparse.Namespace) -> None:
    source = ROOT.resolve()
    if not (source / "SKILL.md").is_file():
        raise SystemExit(f"Cannot install skill: SKILL.md is missing from {source}")

    targets = tuple(SKILL_INSTALL_PATHS) if args.target == "both" else (args.target,)
    home = Path.home()
    destinations = [(target, home / SKILL_INSTALL_PATHS[target]) for target in targets]

    # Validate the complete request before mutating either destination.
    actions = {
        target: _validate_skill_destination(destination, source)
        for target, destination in destinations
    }

    for target, destination in destinations:
        label = "Codex" if target == "codex" else "Claude Code"
        if actions[target] == "current":
            print(f"{label}: already installed at {destination} -> {source}")
            continue
        destination.parent.mkdir(parents=True, exist_ok=True)
        try:
            destination.symlink_to(source, target_is_directory=True)
        except FileExistsError:
            # A concurrent installer may have won the race. Only accept our own link.
            if not _link_points_to(destination, source):
                raise SystemExit(
                    f"Refusing to overwrite unrelated existing path: {destination}"
                )
        print(f"{label}: installed {destination} -> {source}")

    print("\nSkill ready. Restart the agent app if it was already open.")


