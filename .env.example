# Required for `./pdd new` announcement projects: narration-safe pacing uses
# ElevenLabs character timestamps. Also enables ElevenLabs voice and music.
ELEVENLABS_API_KEY=

# Optional: Gemini TTS for legacy/non-auto-paced narration, Lyria music,
# and the advisory video judge.
GEMINI_API_KEY=

# Optional: enables Claude-backed planning in selected capture/script tools.
ANTHROPIC_API_KEY=
